rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /profiles/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
  match /boards/{level}/entries/{uid} { allow get: if true; allow list: if request.query.limit != null && request.query.limit <= 50; allow write: if false; }
  match /rooms/{code} { allow get: if request.auth != null && request.auth.uid in resource.data.members; allow list, write: if false; }
  match /{path=**} { allow read, write: if false; }
 }
}
